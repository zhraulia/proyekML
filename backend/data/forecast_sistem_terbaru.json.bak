{
 "metadata": {
  "sumber_data": "PIHPS - Kota Padang, harga harian (hari kerja Senin-Jumat)",
  "data_terakhir": "2026-11-19",
  "periode_forecast": "2026-11-20 s.d. 2027-11-19",
  "dibuat_pada": "2026-11-21",
  "satuan": "Rupiah per kg",
  "model_per_komoditas": {
   "Daging Ayam": "d=1 M1 (1, 1, 0, 0)",
   "Bawang Merah": "d=1 M1 (1, 0, 0, 0)",
   "Bawang Putih": "d=1 M2 (0, 0, 0, 0)",
   "Cabai Merah": "d=0 M1 (1, 0, 0, 0)",
   "Cabai Rawit": "d=0 M1 (1, 0, 0, 0)"
  },
  "interval": "empiris (dari galat rolling-origin), tingkat 50% dan 80%, hanya sampai horizon 66 hari kerja",
  "kategori_horizon": {
   "h1-5": "1 minggu",
   "h6-22": "sekitar 1 bulan",
   "h23-66": "sekitar 3 bulan",
   "h67+": "indikatif, tanpa interval terkalibrasi"
  },
  "catatan": [
   "Pada data uji 2025 dan 2026 model final tidak terbukti lebih akurat daripada naive (harga terakhir) pada h5 dan h22.",
   "Variabel Ramadan, Lebaran, dan Iduladha tidak meningkatkan akurasi; forecast tidak memuat efek hari besar.",
   "Kalibrasi interval kasar: cakupan di luar sampel bervariasi antar komoditas dan dapat meleset dari tingkat nominal.",
   "Prediksi hanya untuk hari kerja; Sabtu dan Minggu tidak tersedia.",
   "Model dilatih ulang dan interval dihitung ulang setiap ada data PIHPS baru."
  ]
 },
